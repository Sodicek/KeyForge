<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Random_password_generator.ViewModels"
        x:Class="Random_password_generator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://KeyForge/Assets/icon.ico"
        Width="420" Height="680"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="KeyForge" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" Width="130">
                    <ComboBoxItem>Čeština</ComboBoxItem>
                    <ComboBoxItem>English</ComboBoxItem>
                </ComboBox>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="Mode" Content="{Binding ModeCharactersLabel}" IsChecked="{Binding !UsePassphraseMode}" />
                <RadioButton GroupName="Mode" Content="{Binding ModePassphraseLabel}" IsChecked="{Binding UsePassphraseMode}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding !UsePassphraseMode}">
                <CheckBox Content="{Binding CapitalsLabel}" IsChecked="{Binding IncludeCapitals}" />
                <CheckBox Content="{Binding SpecialLabel}" IsChecked="{Binding IncludeSpecial}" />
                <CheckBox Content="{Binding NumbersLabel}" IsChecked="{Binding IncludeNumbers}" />
                <CheckBox Content="{Binding ExcludeAmbiguousLabel}" IsChecked="{Binding ExcludeAmbiguous}" />

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding LengthLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat={}{0:0}}" FontWeight="Bold" />
                    </Grid>
                    <Slider Minimum="{Binding MinLength}" Maximum="64" Value="{Binding Length}"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding UsePassphraseMode}">
                <CheckBox Content="{Binding CapitalizeLabel}" IsChecked="{Binding PassphraseCapitalize}" />
                <CheckBox Content="{Binding AppendNumberLabel}" IsChecked="{Binding PassphraseAppendNumber}" />

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding WordCountLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding PassphraseWordCount, StringFormat={}{0:0}}" FontWeight="Bold" />
                    </Grid>
                    <Slider Minimum="3" Maximum="8" Value="{Binding PassphraseWordCount}"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                </StackPanel>
            </StackPanel>

            <Button Content="{Binding GenerateLabel}" Command="{Binding GenerateCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding GeneratedPassword, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas,Menlo,monospace" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding CopyLabel}" Click="OnCopyClick" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Spacing="4">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding StrengthPercent}"
                             Foreground="{Binding StrengthColor}" Height="6" />
                <TextBlock Text="{Binding StrengthText}" Foreground="{Binding StrengthColor}" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="{Binding SaveToDesktopLabel}" IsChecked="{Binding SaveToDesktop}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SaveToDesktop}">
                    <TextBox Grid.Column="0" PlaceholderText="{Binding DirectoryPlaceholder}" Text="{Binding SaveFolderName}" />
                    <Button Grid.Column="1" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" />

            <Button Content="{Binding UpdateMessage}" Command="{Binding OpenUpdatePageCommand}"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    Foreground="#4FA8E0" Cursor="Hand" />
        </StackPanel>
    </ScrollViewer>
</Window>
